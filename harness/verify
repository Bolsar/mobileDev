#!/bin/sh
# verify — build, test and capture proof for a mobile project.
#
# Usage: verify [--detect-only] [--flow <maestro.yaml>] [project_dir]
#
# Writes proof to <project_dir>/.mobile-agent-proof/<timestamp>/:
#   summary.txt, one <step>.log per step, screenshot.png and device.log
#   when a simulator/emulator is running.
# Exit code is 0 only when every step passed.
#
# iOS needs IOS_SCHEME. Optional: IOS_DESTINATION (default: booted simulator).

set -u

FLOW=""
DETECT_ONLY=0
while [ $# -gt 0 ]; do
  case "$1" in
    --detect-only) DETECT_ONLY=1 ;;
    --flow) FLOW="$2"; shift ;;
    -h|--help) sed -n '2,11p' "$0"; exit 0 ;;
    *) break ;;
  esac
  shift
done
DIR="${1:-.}"
cd "$DIR" || exit 2

# Order matters: Flutter and React Native projects also contain ios/ and android/.
detect() {
  if [ -f pubspec.yaml ]; then echo flutter
  elif [ -f package.json ] && grep -q '"react-native"' package.json; then echo react-native
  elif [ -f Package.swift ] || [ -n "$(find . -maxdepth 1 \( -name '*.xcodeproj' -o -name '*.xcworkspace' \))" ]; then echo ios
  elif [ -f gradlew ] || [ -f build.gradle ] || [ -f build.gradle.kts ]; then echo android
  else echo unknown
  fi
}

STACK=$(detect)
if [ "$DETECT_ONLY" = 1 ]; then echo "$STACK"; exit 0; fi
if [ "$STACK" = unknown ]; then echo "verify: no mobile project found in $(pwd)" >&2; exit 2; fi

OUT=".mobile-agent-proof/$(date +%Y%m%d-%H%M%S)"
mkdir -p "$OUT"
FAILED=0
echo "stack: $STACK" > "$OUT/summary.txt"

# step <name> <command...>: run, log, record PASS/FAIL.
step() {
  name="$1"; shift
  echo "== $name: $*"
  if "$@" > "$OUT/$name.log" 2>&1; then r=PASS; else r=FAIL; FAILED=1; fi
  echo "$r  $name  ($*)" | tee -a "$OUT/summary.txt"
}

case "$STACK" in
  flutter)
    step analyze flutter analyze
    step test flutter test ;;
  react-native)
    step typecheck npx tsc --noEmit
    step lint npx eslint .
    step test npx jest --ci ;;
  ios)
    if [ -z "${IOS_SCHEME:-}" ]; then
      echo "verify: set IOS_SCHEME (see: xcodebuild -list)" >&2; exit 2
    fi
    step lint sh -c 'command -v swiftlint >/dev/null || { echo "swiftlint not installed"; exit 0; }; swiftlint --strict'
    SIM=$(xcrun simctl list devices booted 2>/dev/null | grep -oE '[0-9A-Fa-f-]{36}' | head -1)
    if [ -z "${IOS_DESTINATION:-}" ] && [ -z "$SIM" ]; then
      echo "verify: boot a simulator or set IOS_DESTINATION" >&2; exit 2
    fi
    step test xcodebuild test -scheme "$IOS_SCHEME" -destination "${IOS_DESTINATION:-platform=iOS Simulator,id=$SIM}" ;;
  android)
    step test ./gradlew testDebugUnitTest
    step lint ./gradlew lint ;;
esac

if [ -n "$FLOW" ]; then
  if command -v maestro >/dev/null; then
    step flow maestro test "$FLOW" --test-output-dir "$OUT/maestro"
  else
    echo "FAIL  flow  (maestro not installed: https://docs.maestro.dev)" | tee -a "$OUT/summary.txt"; FAILED=1
  fi
fi

# Screenshot and recent logs from whatever device is running. Missing device is not a failure.
if xcrun simctl list devices booted 2>/dev/null | grep -q Booted; then
  xcrun simctl io booted screenshot "$OUT/screenshot.png" >/dev/null 2>&1
  xcrun simctl spawn booted log show --last 5m --style compact > "$OUT/device.log" 2>&1
  echo "captured: iOS simulator screenshot + log" >> "$OUT/summary.txt"
elif command -v adb >/dev/null && [ "$(adb get-state 2>/dev/null)" = device ]; then
  adb exec-out screencap -p > "$OUT/screenshot.png" 2>/dev/null
  adb logcat -d -t 2000 > "$OUT/device.log" 2>&1
  echo "captured: Android screenshot + logcat" >> "$OUT/summary.txt"
else
  echo "captured: nothing (no booted simulator or emulator)" >> "$OUT/summary.txt"
fi

echo "proof: $(pwd)/$OUT"
if [ "$FAILED" = 0 ]; then r=PASS; else r=FAIL; fi
echo "RESULT $r" | tee -a "$OUT/summary.txt"
exit "$FAILED"
